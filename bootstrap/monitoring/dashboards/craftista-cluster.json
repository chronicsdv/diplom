       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "noValue": "нет данных",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
