     "legendFormat": "{{deployment}} доступно",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\"}",
     "legendFormat": "{{deployment}} желаемо",
     "refId": "B"
