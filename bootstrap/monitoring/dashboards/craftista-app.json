{
 "uid": "craftista-app",
 "title": "Craftista / Приложение",
 "description": "Состояние и ресурсы приложения. Переменная Namespace: craftista (по умолчанию), logging (ELK), monitoring и т.д.",
 "tags": [
  "craftista",
  "kubernetes"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Состояние (namespace из переменной, по умолчанию craftista)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Реплики Deployment готовы",
   "description": "Доля доступных реплик от желаемых по всем Deployment в namespace. Меньше 100% = что-то не поднялось.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(kube_deployment_status_replicas_available{namespace=\"$namespace\"}) / sum(kube_deployment_spec_replicas{namespace=\"$namespace\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [],
     "noValue": "нет данных"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "StatefulSet готовы (БД)",
   "description": "PostgreSQL catalogue-db и другие StatefulSet в namespace.",
