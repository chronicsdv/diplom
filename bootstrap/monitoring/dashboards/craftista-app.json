  {
   "id": 16,
   "type": "timeseries",
   "title": "Память: % от limit по контейнерам",
   "description": "Близко к 100% = OOMKilled. Подбирайте limits.memory в values.yaml по этому графику.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}) / on (pod, container) max by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"memory\"}) * 100",
     "legendFormat": "{{pod}}/{{container}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
